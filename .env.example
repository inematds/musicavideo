# musicavideo — chaves usadas
#
# ESTE ARQUIVO É SÓ DOCUMENTAÇÃO. Não preencha valores aqui.
# As chaves reais são lidas EM RUNTIME dos .env autorizados, nesta ordem:
#   1. ~/projetos/openpcbotv2/.env
#   2. ~/projetos/wifi/.env
# NUNCA copie valores de chave para dentro deste repositório, para a saída
# em ~/projetos/output/musicavideo/ ou para qualquer log.
#
# Provedor sem chave não quebra nada: ele aparece como INDISPONÍVEL COM O
# MOTIVO no `plano`, e o `faz` daquela parte vira `erro` sem derrubar as outras.


# ─────────────────────────────────────────────── música (a única parte paga)

# kie.ai — Suno v4.5. ~US$ 0,08 por geração (traz 2 faixas).
# Mora hoje em ~/projetos/wifi/.env. Chave em https://kie.ai/api-key
KIE_API_KEY=


# ─────────────────────────────────────────── capa e clipe (default: custo ZERO)

# Agnes AI — imagem E vídeo a custo zero, sem crédito. É o DEFAULT das duas
# partes, e o motivo de o projeto rodar em qualquer VPS.
# Exige prompt em INGLÊS: a API filtra português legítimo (o plano já valida).
# Mora hoje em ~/projetos/openpcbotv2/.env. Gateway: https://apihub.agnes-ai.com
AGNES_API_KEY=


# ─────────────────────────────────────────────── alternativas pagas de clipe
# (registradas e prontas, NÃO exercitadas contra API real ainda)

# fal.ai — Kling v2.5 turbo pro, ~US$ 0,07/s. Chave em https://fal.ai/dashboard/keys
FAL_KEY=

# Kling via kie.ai — ~US$ 0,056/s. Usa a MESMA KIE_API_KEY acima.


# ─────────────────────────────────────────────── entrega opcional
# Só usados com a flag --telegram (desligado por default).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─────────────────────────────────────────────── capa alternativa, local
# inemaimg (flux2-klein no DGX) NÃO usa chave: basta o servidor responder em
# http://localhost:8000. Sem servidor, aparece indisponível com esse motivo.
