{
  "nome": "musicavideo",
  "prefixo": "MVD",
  "versao_def": 1,
  "alvos": {
    "unico": {
      "canal": "lives10",
      "gatilho": "usuário pede uma música com capa e clipe a partir de uma frase"
    }
  },
  "fases": [
    {
      "id": "plano",
      "escopo": "fluxo",
      "fila": "texto",
      "kind": "function",
      "tarefa": "cli.rodar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "portao": {
        "mostrar": [
          "{{artefato:plano}}"
        ]
      },
      "comando": "bash {{repo}}/musicavideo.sh plano {{input}} --bruto --mvd {{ref}}"
    },
    {
      "id": "musica",
      "escopo": "fluxo",
      "fila": "io",
      "kind": "function",
      "tarefa": "cli.rodar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "portao": {
        "mostrar": [
          "{{artefato:musica}}",
          "{{artefato:musica_alt}}?"
        ],
        "respostas": {
          "refaz": "bash {{repo}}/musicavideo.sh reprova {{anterior:slug}} musica",
          "correcao": "bash {{repo}}/musicavideo.sh ajusta {{anterior:slug}} musica {{resposta}} --refaz",
          "a": {
            "comando": "bash {{repo}}/musicavideo.sh aprova {{anterior:slug}} musica --faixa 1",
            "reabre": false
          },
          "b": {
            "comando": "bash {{repo}}/musicavideo.sh aprova {{anterior:slug}} musica --faixa 2",
            "reabre": false
          }
        }
      },
      "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} musica --sim --sem-revisao --aprovar"
    },
    {
      "id": "capa",
      "escopo": "fluxo",
      "fila": "io",
      "kind": "function",
      "tarefa": "cli.rodar",
      "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} capa --sim --sem-revisao --aprovar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "portao": {
        "mostrar": [
          "{{artefato:capa}}"
        ],
        "respostas": {
          "refaz": "bash {{repo}}/musicavideo.sh reprova {{anterior:slug}} capa",
          "correcao": "bash {{repo}}/musicavideo.sh ajusta {{anterior:slug}} capa {{resposta}} --refaz"
        }
      }
    },
    {
      "id": "clipe",
      "escopo": "fluxo",
      "fila": "render",
      "kind": "function",
      "tarefa": "cli.rodar",
      "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} clipe --sim --sem-revisao --aprovar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "espera": {
        "intervalo": 60,
        "timeout": 14400
      },
      "portao": {
        "mostrar": [
          "{{artefato:clipe}}"
        ],
        "respostas": {
          "reprova": "bash {{repo}}/musicavideo.sh reprova {{anterior:slug}} clipe {{resposta}}",
          "ritmo": {
            "comando": "bash {{repo}}/musicavideo.sh recorta {{anterior:slug}} --ritmo {{resposta}}",
            "reabre": false
          },
          "correcao": "bash {{repo}}/musicavideo.sh ajusta {{anterior:slug}} clipe {{resposta}} --refaz"
        }
      }
    },
    {
      "id": "entrega",
      "escopo": "fluxo",
      "fila": "io",
      "kind": "function",
      "tarefa": "cli.rodar",
      "max_tentativas": 2,
      "pausa_apos": false,
      "comando": "bash {{repo}}/musicavideo.sh pacote {{anterior:slug}}"
    }
  ],
  "consultas": {
    "lista": "bash {{repo}}/musicavideo.sh lista 10",
    "busca": "bash {{repo}}/musicavideo.sh busca {{input}}",
    "estilos": "python3 -c \"import json;d=json.load(open('{{repo}}/data/estilos.json'))['estilos'];print('\\n'.join(f\\\"{e['id']}  {', '.join(e.get('genero',[])[:2])}\\\" for e in d))\"",
    "custo": "bash {{repo}}/musicavideo.sh custo {{input}}"
  }
}