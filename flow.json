{
  "nome": "musicavideo",
  "prefixo": "MVD",
  "versao_def": 1,
  "alvos": {
    "unico": {
      "canal": "lives10",
      "gatilho": "usuário pede uma música com capa e clipe a partir de uma frase"
    }
  },
  "fases": [
    {
      "id": "plano",
      "escopo": "fluxo",
      "fila": "texto",
      "kind": "function",
      "tarefa": "cli.rodar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "portao": {
        "mostrar": [
          "{{artefato:plano}}"
        ]
      },
      "comando": "bash {{repo}}/musicavideo.sh plano {{input}} --bruto"
    },
    {
      "id": "musica",
      "escopo": "fluxo",
      "fila": "io",
      "kind": "function",
      "tarefa": "cli.rodar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "portao": {
        "mostrar": [
          "{{artefato:musica}}"
        ]
      },
      "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} musica --sim --sem-revisao --aprovar"
    },
    {
      "id": "capa",
      "escopo": "fluxo",
      "fila": "io",
      "kind": "function",
      "tarefa": "cli.rodar",
      "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} capa --sim --sem-revisao --aprovar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "portao": {
        "mostrar": [
          "{{artefato:capa}}"
        ]
      }
    },
    {
      "id": "clipe",
      "escopo": "fluxo",
      "fila": "render",
      "kind": "function",
      "tarefa": "cli.rodar",
      "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} clipe --sim --sem-revisao --aprovar",
      "max_tentativas": 2,
      "pausa_apos": true,
      "espera": {
        "intervalo": 60,
        "timeout": 10800
      },
      "portao": {
        "mostrar": [
          "{{artefato:clipe}}"
        ]
      }
    },
    {
      "id": "entrega",
      "escopo": "fluxo",
      "fila": "io",
      "kind": "function",
      "tarefa": "cli.rodar",
      "max_tentativas": 2,
      "pausa_apos": false,
      "comando": "bash {{repo}}/musicavideo.sh pacote {{anterior:slug}}"
    }
  ]
}
